// 1. COPIA E ORDINA (Senza modificare l'originale)
// Spread operator [...] crea una copia, poi sort() ordina quella.
let copiaOrdinata = [...originale].sort((a,b) => a - b);

// 2. RIMUOVI DUPLICATI
let unici = [...new Set([1, 2, 2, 1])]; // [1, 2]

// 3. DEEP COPY (Clonare Oggetti Semplici)
