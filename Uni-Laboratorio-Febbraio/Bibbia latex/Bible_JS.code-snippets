	},
	"Clone Object": {
		"prefix": "clone",
		"body": [
			"const ${1:clone} = JSON.parse(JSON.stringify(${2:original}));"
		],
		"description": "Deep Clone (JSON hack)"
	},
	"Recursive Function": {
		"prefix": "rec",
		"body": [
			"function ${1:funzioneRicorsiva}(n) {",
			"\t// 1. Caso Base: mi fermo",
			"\tif (n <= ${2:0}) return ${3:val};",
			"\t",
			"\t// 2. Passo Ricorsivo: passo il problema ridotto",
			"\treturn ${4:operazione} + ${1:funzioneRicorsiva}(n - 1);",
			"}"
		],
		"description": "Boilerplate Funzione Ricorsiva"
	},
	"Fibonacci Recursive": {
		"prefix": "fib",
		"body": [
			"function fib(n) {",
			"\tif (n <= 1) return n; // 0 o 1",
			"\treturn fib(n - 1) + fib(n - 2);",
			"}"
		],
		"description": "Fibonacci Ricorsivo"
	},
	"Binary Tree Node": {
		"prefix": "treeNode",
		"body": [
			"// Nodo semplice per albero binario",
			"const ${1:nodo} = { val: ${2:valore}, sx: null, dx: null };"
		],
		"description": "Nodo Albero Binario Semplice"
	},
	"DFS Pre-Order": {
		"prefix": "dfsPre",
		"body": [
			"function preOrder(nodo) {",
			"\tif (!nodo) return;",
			"\tconsole.log(nodo.val); // VISITA (Prima della discesa)",
			"\tpreOrder(nodo.sx);",
			"\tpreOrder(nodo.dx);",
			"}"
		],
		"description": "Visita Pre-Order: IO -> SX -> DX"
	},
	"DFS In-Order": {
		"prefix": "dfsIn",
		"body": [
			"function inOrder(nodo) {",
			"\tif (!nodo) return;",
			"\tinOrder(nodo.sx);",
			"\tconsole.log(nodo.val); // VISITA (Nel mezzo)",
			"\tinOrder(nodo.dx);",
			"}"
		],
		"description": "Visita In-Order: SX -> IO -> DX"
	},
	"DFS Post-Order": {
		"prefix": "dfsPost",
		"body": [
			"function postOrder(nodo) {",
			"\tif (!nodo) return;",
			"\tpostOrder(nodo.sx);",
			"\tpostOrder(nodo.dx);",
			"\tconsole.log(nodo.val); // VISITA (Dopo la discesa)",
			"}"
		],
		"description": "Visita Post-Order: SX -> DX -> IO"
	},
	"BFS Tree": {
		"prefix": "bfs",
		"body": [
			"function bfs(radice) {",
			"\tif (!radice) return;",
			"\tconst coda = [radice]; // Coda FIFO",
			"",
			"\twhile (coda.length > 0) {",
			"\t\tconst nodo = coda.shift(); // Prendo il primo",
			"\t\tconsole.log(nodo.val);     // VISITA",
			"",
			"\t\tif (nodo.sx) coda.push(nodo.sx);   // Accodo figli",
			"\t\tif (nodo.dx) coda.push(nodo.dx);",
			"\t}",
			"}"
		],
		"description": "Visita Ampiezza Albero (Coda)"
	},
	"BST Search": {
		"prefix": "bstSearch",
		"body": [
			"function search(nodo, target) {",
			"\tif (!nodo) return false;      // Non trovato",
			"\tif (nodo.val === target) return true; // Trovato!",
			"",
			"\tif (target < nodo.val) return search(nodo.sx, target); // Cerca a SX",
			"\treturn search(nodo.dx, target); // Cerca a DX",
			"}"
		],
		"description": "Ricerca Binaria BST"
	},
	"BST Insert": {
		"prefix": "bstInsert",
		"body": [
			"function insert(nodo, val) {",
			"\tif (!nodo) return { val: val, sx: null, dx: null }; // Crea nuovo se null",
			"",
			"\tif (val < nodo.val) {",
			"\t\tnodo.sx = insert(nodo.sx, val); // Vai a SX",
			"\t} else {",
			"\t\tnodo.dx = insert(nodo.dx, val); // Vai a DX",
			"\t}",
			"\treturn nodo;",
			"}"
		],
		"description": "Inserimento BST"
	},
	"Graph Builder": {
		"prefix": "graphBuilder",
		"body": [
			"// Mappa di Adiacenza: Chiave -> Array di Vicini",
			"const grafo = new Map();",
			"grafo.set('A', ['B', 'C']);"
		],
		"description": "Inizializzazione Grafo (Map)"
	},
	"Graph DFS": {
		"prefix": "graphDFS",
		"body": [
			"function dfsGraph(nodo, visitati = new Set()) {",
			"\tvisitati.add(nodo);",
			"\tconsole.log(nodo); // VISITA",
			"",
			"\tconst vicini = grafo.get(nodo) || [];",
			"\tfor (const vicino of vicini) {",
			"\t\tif (!visitati.has(vicino)) {",
			"\t\t\tdfsGraph(vicino, visitati); // Ricorsione",
			"\t\t}",
			"\t}",
			"}"
		],
		"description": "Visita Profondità Grafo (Visited Set)"
	},
	"Graph BFS": {
		"prefix": "graphBFS",
		"body": [
			"function bfsGraph(nodoPartenza) {",
			"\tconst visitati = new Set([nodoPartenza]);",
			"\tconst coda = [nodoPartenza];",
			"",
			"\twhile (coda.length > 0) {",
			"\t\tconst nodo = coda.shift(); // Prendo il primo",
			"\t\tconsole.log(nodo); // VISITA",
			"",
			"\t\tconst vicini = grafo.get(nodo) || [];",
			"\t\tfor (const vicino of vicini) {",
			"\t\t\tif (!visitati.has(vicino)) {",
			"\t\t\t\tvisitati.add(vicino); // Segna SUBITO",
			"\t\t\t\tcoda.push(vicino);",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"}"
		],
		"description": "Visita Ampiezza Grafo (Coda + Visited)"
	}
}