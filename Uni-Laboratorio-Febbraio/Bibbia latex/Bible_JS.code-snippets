	"For Loop": {
		"prefix": "for",
		"body": [
			"for (let ${1:i} = 0; ${1:i} < ${2:array}.length; ${1:i}++) {",
			"\tconst ${3:element} = ${2:array}[${1:i}];",
			"\t$0",
			"}"
		],
		"description": "Ciclo For classico"
	},
	"For Reverse": {
		"prefix": "forr",
		"body": [
			"for (let ${1:i} = ${2:array}.length - 1; ${1:i} >= 0; ${1:i}--) {",
			"\tconst ${3:element} = ${2:array}[${1:i}];",
			"\t$0",
			"}"
		],
		"description": "Ciclo For inverso"
	},
	"For Of": {
		"prefix": "forof",
		"body": [
			"for (const ${1:element} of ${2:iterable}) {",
			"\t$0",
			"}"
		],
		"description": "Ciclo su valori (Array/String/Map)"
	},
	"For In": {
		"prefix": "forin",
		"body": [
			"for (const ${1:key} in ${2:object}) {",
			"\tif (Object.hasOwnProperty.call(${2:object}, ${1:key})) {",
			"\t\tconst ${3:element} = ${2:object}[${1:key}];",
			"\t\t$0",
			"\t}",
			"}"
		],
		"description": "Ciclo su chiavi (Oggetti)"
	},
	"Map": {
		"prefix": "map",
