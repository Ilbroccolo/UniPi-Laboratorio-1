			"}, ${4:initialValue});"
		],
		"description": "Array Reduce"
	},
	"Class Definition": {
		"prefix": "class",
		"body": [
			"class ${1:ClassName} {",
			"\tconstructor(${2:params}) {",
			"\t\tthis.${3:prop} = ${2:params};",
			"\t}",
			"",
			"\t${4:methodName}() {",
			"\t\t$0",
			"\t}",
			"}"
